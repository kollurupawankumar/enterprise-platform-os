<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.society.dashboard.controller.DashboardController">

    <VBox spacing="20"
          alignment="TOP_LEFT">

        <padding>
            <Insets top="20"
                    right="20"
                    bottom="20"
                    left="20"/>
        </padding>

        <Label fx:id="welcomeLabel"
               styleClass="dashboard-title"/>

        <GridPane hgap="20"
                  vgap="20">

            <!-- Members -->

            <VBox GridPane.columnIndex="0"
                  GridPane.rowIndex="0"
                  styleClass="dashboard-card">

                <Label text="Members"/>

                <Label fx:id="membersCountLabel"
                       text="0"
                       styleClass="dashboard-value"/>

            </VBox>

            <!-- Shares -->

            <VBox GridPane.columnIndex="1"
                  GridPane.rowIndex="0"
                  styleClass="dashboard-card">

                <Label text="Shares"/>

                <Label fx:id="sharesCountLabel"
                       text="0"
                       styleClass="dashboard-value"/>

            </VBox>

            <!-- Certificates -->

            <VBox GridPane.columnIndex="0"
                  GridPane.rowIndex="1"
                  styleClass="dashboard-card">

                <Label text="Certificates"/>

                <Label fx:id="certificatesCountLabel"
                       text="0"
                       styleClass="dashboard-value"/>

            </VBox>

            <!-- Database -->

            <VBox GridPane.columnIndex="1"
                  GridPane.rowIndex="1"
                  styleClass="dashboard-card">

                <Label text="Database"/>

                <Label fx:id="databaseStatusLabel"
                       text="Connected"
                       styleClass="dashboard-value"/>

            </VBox>

        </GridPane>

    </VBox>

</StackPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.society.app.MainController">

    <top>

        <ToolBar>

            <Label fx:id="societyNameLabel"
                   text="Society"
                   style="-fx-font-size:18px;
                          -fx-font-weight:bold;"/>

        </ToolBar>

    </top>

    <left>

        <VBox spacing="10"
              prefWidth="220">

            <padding>
                <Insets top="15"
                        right="10"
                        bottom="15"
                        left="10"/>
            </padding>

            <Button fx:id="dashboardBtn"
                    text="Dashboard"
                    maxWidth="Infinity"/>

            <Button fx:id="memberBtn"
                    text="Members"
                    maxWidth="Infinity"/>

            <Button fx:id="shareBtn"
                    text="Shares"
                    maxWidth="Infinity"/>

            <Button fx:id="certificateBtn"
                    text="Certificates"
                    maxWidth="Infinity"/>

            <Button fx:id="reportBtn"
                    text="Reports"
                    maxWidth="Infinity"/>

            <Button fx:id="adminBtn"
                    text="Administration"
                    maxWidth="Infinity"/>

        </VBox>

    </left>

    <center>

        <StackPane fx:id="contentPane">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

        </StackPane>

    </center>

    <bottom>

        <HBox spacing="10">

            <padding>
                <Insets top="8"
                        right="8"
                        bottom="8"
                        left="8"/>
            </padding>

            <Label text="Version"/>

            <Label fx:id="versionLabel"/>

        </HBox>

    </bottom>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.45"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.society.admin.controller.AdministrationController"
           styleClass="main-content">

    <!-- Left Side: Society Info Profile Update Panel -->
    <VBox spacing="15">
        <padding>
            <Insets top="20" right="15" bottom="20" left="20"/>
        </padding>
        <Label text="Society Profile Settings" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F4E79;"/>
        
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: white;">
            <GridPane hgap="10" vgap="12">
                <columnConstraints>
                    <ColumnConstraints prefWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Society Name:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="nameField" GridPane.columnIndex="1"/>

                <Label text="Registration No:" style="-fx-font-weight: bold;" GridPane.rowIndex="1"/>
                <TextField fx:id="regNoField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Short Name:" style="-fx-font-weight: bold;" GridPane.rowIndex="2"/>
                <TextField fx:id="shortNameField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Email:" style="-fx-font-weight: bold;" GridPane.rowIndex="3"/>
                <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Phone:" style="-fx-font-weight: bold;" GridPane.rowIndex="4"/>
                <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Website:" style="-fx-font-weight: bold;" GridPane.rowIndex="5"/>
                <TextField fx:id="websiteField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Address:" style="-fx-font-weight: bold;" GridPane.rowIndex="6"/>
                <TextArea fx:id="addressArea" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Button text="Save Details" onAction="#handleSaveSocietyDetails" styleClass="button-primary" GridPane.columnIndex="1" GridPane.rowIndex="7" prefWidth="150"/>
            </GridPane>
        </ScrollPane>
    </VBox>

    <!-- Right Side: System User Profiles Management -->
    <VBox spacing="15">
        <padding>
            <Insets top="20" right="20" bottom="20" left="15"/>
        </padding>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="System Users &amp; Committee" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F4E79;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Add User" onAction="#handleAddUser" styleClass="button-primary"/>
        </HBox>
        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8;">
            <columns>
                <TableColumn fx:id="usernameCol" text="Username" prefWidth="120"/>
                <TableColumn fx:id="firstNameCol" text="First Name" prefWidth="120"/>
                <TableColumn fx:id="roleCol" text="Role" prefWidth="120"/>
                <TableColumn fx:id="emailCol" text="Email Address" prefWidth="180"/>
            </columns>
        </TableView>
    </VBox>
</SplitPane>

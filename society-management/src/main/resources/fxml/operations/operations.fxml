<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.society.operations.controller.OperationsController"
         styleClass="main-content">

    <!-- Tab 1: Assets -->
    <Tab text="Asset Register">
        <SplitPane dividerPositions="0.6">
            <!-- Left Panel: Assets Table -->
            <VBox spacing="15">
                <padding>
                    <Insets top="15" right="10" bottom="15" left="15"/>
                </padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Society Assets" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Add Asset" onAction="#handleAddAsset" styleClass="button-primary"/>
                </HBox>
                <TableView fx:id="assetTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="assetNameCol" text="Asset Name" prefWidth="180"/>
                        <TableColumn fx:id="assetCategoryCol" text="Category" prefWidth="120"/>
                        <TableColumn fx:id="assetStatusCol" text="Status" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right Panel: Asset Details & AMC -->
            <VBox spacing="15" style="-fx-background-color: #F8FAFC; -fx-padding: 15;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Asset &amp; AMC Details" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Edit Asset" onAction="#handleEditAsset" styleClass="button-secondary"/>
                </HBox>

                <GridPane hgap="10" vgap="10" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 6;">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    
                    <Label text="Serial No:" style="-fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                    <Label fx:id="serialLabel" text="-" GridPane.columnIndex="1"/>
                    
                    <Label text="Purchase Date:" style="-fx-font-weight: bold; -fx-text-fill: #64748B;" GridPane.rowIndex="1"/>
                    <Label fx:id="purchaseDateLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    
                    <Label text="Purchase Cost:" style="-fx-font-weight: bold; -fx-text-fill: #64748B;" GridPane.rowIndex="2"/>
                    <Label fx:id="purchaseCostLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    
                    <Label text="Warranty Expiry:" style="-fx-font-weight: bold; -fx-text-fill: #64748B;" GridPane.rowIndex="3"/>
                    <Label fx:id="warrantyLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>

                <Label text="Annual Maintenance Contract (AMC)" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                <GridPane hgap="10" vgap="10" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 6;">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="AMC Vendor:" style="-fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                    <Label fx:id="amcVendorLabel" text="-" GridPane.columnIndex="1"/>

                    <Label text="AMC Duration:" style="-fx-font-weight: bold; -fx-text-fill: #64748B;" GridPane.rowIndex="1"/>
                    <Label fx:id="amcPeriodLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="AMC Cost:" style="-fx-font-weight: bold; -fx-text-fill: #64748B;" GridPane.rowIndex="2"/>
                    <Label fx:id="amcCostLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="AMC Details:" style="-fx-font-weight: bold; -fx-text-fill: #64748B;" GridPane.rowIndex="3"/>
                    <Label fx:id="amcDetailsLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>

                <HBox alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                    <Label text="Service Visits &amp; Photo Logs" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Log Service Visit" onAction="#handleLogServiceVisit" styleClass="button-primary"/>
                </HBox>

                <TableView fx:id="serviceLogTable" VBox.vgrow="ALWAYS" prefHeight="150" style="-fx-background-radius: 6;">
                    <columns>
                        <TableColumn fx:id="serviceDateCol" text="Date" prefWidth="90"/>
                        <TableColumn fx:id="serviceTypeCol" text="Type" prefWidth="100"/>
                        <TableColumn fx:id="serviceEngCol" text="Engineer" prefWidth="110"/>
                        <TableColumn fx:id="serviceSummaryCol" text="Work Done / Remarks" prefWidth="180"/>
                        <TableColumn fx:id="serviceDocCol" text="Receipt / Photo" prefWidth="110"/>
                    </columns>
                </TableView>
            </VBox>
        </SplitPane>
    </Tab>

    <!-- Tab 2: Vendors -->
    <Tab text="Vendor Directory">
        <SplitPane dividerPositions="0.6">
            <!-- Left Panel: Vendors Table -->
            <VBox spacing="15">
                <padding>
                    <Insets top="15" right="10" bottom="15" left="15"/>
                </padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Contracted Vendors" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Add Vendor" onAction="#handleAddVendor" styleClass="button-primary"/>
                </HBox>
                <TableView fx:id="vendorTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="vendorNameCol" text="Vendor Name" prefWidth="180"/>
                        <TableColumn fx:id="vendorCategoryCol" text="Category" prefWidth="120"/>
                        <TableColumn fx:id="vendorPhoneCol" text="Phone" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right Panel: Vendor Details -->
            <VBox spacing="15" style="-fx-background-color: #F8FAFC; -fx-padding: 15;">
                <Label text="Vendor Profile" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <GridPane hgap="10" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="110"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    
                    <Label text="Contact Person:" style="-fx-font-weight: bold;"/>
                    <Label fx:id="contactPersonLabel" text="-" GridPane.columnIndex="1"/>
                    
                    <Label text="Email:" style="-fx-font-weight: bold;" GridPane.rowIndex="1"/>
                    <Label fx:id="emailLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    
                    <Label text="Address:" style="-fx-font-weight: bold;" GridPane.rowIndex="2"/>
                    <Label fx:id="addressLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>
            </VBox>
        </SplitPane>
    </Tab>

    <!-- Tab 3: Facilities -->
    <Tab text="Society Facilities">
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Society Facilities &amp; Amenities" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Add Facility" onAction="#handleAddFacility" styleClass="button-primary"/>
            </HBox>
            <TableView fx:id="facilityTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="facilityNameCol" text="Facility Name" prefWidth="180"/>
                    <TableColumn fx:id="facilityTypeCol" text="Type" prefWidth="130"/>
                    <TableColumn fx:id="facilityLocationCol" text="Location" prefWidth="160"/>
                    <TableColumn fx:id="facilityCapacityCol" text="Capacity" prefWidth="100"/>
                    <TableColumn fx:id="facilityTimingsCol" text="Timings" prefWidth="150"/>
                    <TableColumn fx:id="facilityStatusCol" text="Status" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <!-- Tab 4: Staff Directory & Police Verification -->
    <Tab text="Staff &amp; Police Verification">
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="On-Premise Staff &amp; Police Verification Directory" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Add Staff Member" onAction="#handleAddStaff" styleClass="button-primary"/>
                <Button text="Deactivate / End Term" onAction="#handleDeactivateStaff" styleClass="button-danger"/>
            </HBox>
            <TableView fx:id="staffTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="staffNameCol" text="Staff Name" prefWidth="170"/>
                    <TableColumn fx:id="staffRoleCol" text="Role" prefWidth="120"/>
                    <TableColumn fx:id="staffMobileCol" text="Mobile" prefWidth="120"/>
                    <TableColumn fx:id="staffShiftCol" text="Shift Timing" prefWidth="120"/>
                    <TableColumn fx:id="staffPoliceStatusCol" text="Police Verification" prefWidth="140"/>
                    <TableColumn fx:id="staffDocPathCol" text="Document Path" prefWidth="160"/>
                    <TableColumn fx:id="staffStatusCol" text="Status" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>
</TabPane>

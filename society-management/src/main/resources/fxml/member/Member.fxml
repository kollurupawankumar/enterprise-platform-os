<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.society.member.controller.MemberController"
            stylesheets="/css/member.css">

    <top>

        <VBox spacing="15">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="Member Management"
                   styleClass="dashboard-title"/>

            <HBox spacing="10" alignment="CENTER_LEFT">

                <TextField fx:id="searchField"
                           promptText="Search by Member Number, Membership Number, Name or Mobile"
                           styleClass="search-field"
                           HBox.hgrow="ALWAYS"/>

                <Button text="Search"
                        styleClass="button-primary"
                        onAction="#searchMembers"/>

            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">

                <Button text="New"
                        styleClass="button-primary"
                        onAction="#addMember"/>

                <Button text="View Details"
                        styleClass="button-secondary"
                        onAction="#viewMemberDetails"/>

                <Button text="Edit"
                        styleClass="button-secondary"
                        onAction="#editMember"/>

                <Button text="Delete"
                        styleClass="button-danger"
                        onAction="#deleteMember"/>

                <Button text="Refresh"
                        styleClass="button-secondary"
                        onAction="#refresh"/>

                <Button text="Download Template"
                        styleClass="button-secondary"
                        onAction="#downloadTemplate"/>

                <Button text="Bulk Import CSV"
                        styleClass="button-primary"
                        onAction="#bulkImportCsv"/>

            </HBox>

        </VBox>

    </top>

    <center>

        <TableView fx:id="memberTable"
                   VBox.vgrow="ALWAYS" onMouseClicked="#memberDoubleClicked">

            <columns>

                <TableColumn fx:id="memberNumberColumn"
                             text="Member No"
                             prefWidth="140"/>

                <TableColumn fx:id="membershipNumberColumn"
                             text="Membership No"
                             prefWidth="170"/>

                <TableColumn fx:id="memberNameColumn"
                             text="Member Name"
                             prefWidth="260"/>

                <TableColumn fx:id="mobileColumn"
                             text="Mobile"
                             prefWidth="170"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"
                             prefWidth="120"/>

            </columns>

        </TableView>

    </center>

    <bottom>

        <HBox alignment="CENTER_LEFT">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="10"
                        left="20"/>
            </padding>

            <Label fx:id="totalMembersLabel"
                   text="Total Members : 0"/>

        </HBox>

    </bottom>

</BorderPane>
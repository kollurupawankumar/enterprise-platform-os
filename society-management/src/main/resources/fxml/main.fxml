<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootBorderPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.society.common.controller.MainController">

    <top>
        <fx:include source="/fxml/header/header.fxml"/>
    </top>

    <left>

        <VBox spacing="8"
              prefWidth="220"
              styleClass="navigation">

            <padding>
                <Insets top="15" right="10" bottom="15" left="10"/>
            </padding>

            <Button
                    fx:id="dashboardButton"
                    text="Dashboard"
                    onAction="#openDashboard"/>

            <Button
                    fx:id="membersButton"
                    text="Members"
                    onAction="#openMembers"/>

            <Button
                    fx:id="propertiesButton"
                    text="Properties"
                    onAction="#openProperties"/>

            <Button
                    fx:id="governanceButton"
                    text="Governance"
                    onAction="#openGovernance"/>

            <Button
                    fx:id="operationsButton"
                    text="Operations"
                    onAction="#openOperations"/>

            <Button
                    fx:id="financeButton"
                    text="Finance"
                    onAction="#openFinance"/>

            <Button
                    fx:id="searchButton"
                    text="Universal Search"
                    onAction="#openSearch"/>

            <Button
                    fx:id="sharesButton"
                    text="Shares"
                    onAction="#openShares"/>

            <Button
                    fx:id="certificatesButton"
                    text="Certificates"
                    onAction="#openCertificates"/>

            <Button
                    fx:id="reportsButton"
                    text="Reports"
                    onAction="#openReports"/>

            <Button
                    fx:id="administrationButton"
                    text="Administration"
                    onAction="#openAdministration"/>

        </VBox>

    </left>

    <center>

        <StackPane fx:id="contentHost"/>

    </center>

    <bottom>

        <fx:include source="/fxml/footer/footer.fxml"/>

    </bottom>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.society.common.controller.MainController">

    <top>

        <HBox spacing="10"
              alignment="CENTER_LEFT"
              styleClass="header">

            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>

            <Label text="Society Management System"
                   styleClass="header-title"/>

        </HBox>

    </top>

    <left>

        <VBox spacing="8"
              prefWidth="220"
              styleClass="navigation">

            <padding>
                <Insets top="15" right="10" bottom="15" left="10"/>
            </padding>

            <Button text="Dashboard"
                    onAction="#openDashboard"/>

            <Button text="Members"
                    onAction="#openMembers"/>

            <Button text="Shares"
                    onAction="#openShares"/>

            <Button text="Certificates"
                    onAction="#openCertificates"/>

            <Button text="Reports"
                    onAction="#openReports"/>

            <Button text="Administration"
                    onAction="#openAdministration"/>

        </VBox>

    </left>

    <center>

        <StackPane fx:id="contentHost"/>

    </center>

    <bottom>

        <HBox spacing="10"
              styleClass="status-bar">

            <padding>
                <Insets top="6" right="10" bottom="6" left="10"/>
            </padding>

            <Label text="Ready"/>

            <HBox.hgrow>
                <Priority fx:constant="ALWAYS"/>
            </HBox.hgrow>

            <Label text="Version 1.0.0"/>

        </HBox>

    </bottom>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clinical.ui.controller.VisitViewController"
      style="-fx-background-color: #F8FAFC; -fx-padding: 20;">
    <Label text="Visit &amp; Encounter Management" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
    <HBox spacing="15">
        <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" prefWidth="300">
            <Label text="Create Visit / OPD Token" style="-fx-font-weight: bold;"/>
            <TextField fx:id="patientIdField" promptText="Patient ID (e.g. PAT-000001)"/>
            <TextField fx:id="doctorNameField" promptText="Assigned Doctor"/>
            <Button text="Create Visit" onAction="#handleCreateVisit" style="-fx-background-color: #2563EB; -fx-text-fill: white;"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
            <Label text="Active OPD Queue" style="-fx-font-weight: bold;"/>
            <TableView fx:id="visitQueueTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="visitIdCol" text="Visit ID" prefWidth="140"/>
                    <TableColumn fx:id="patientCol" text="Patient ID" prefWidth="120"/>
                    <TableColumn fx:id="doctorCol" text="Doctor" prefWidth="150"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>

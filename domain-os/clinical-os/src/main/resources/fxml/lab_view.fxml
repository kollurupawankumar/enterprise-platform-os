<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clinical.ui.controller.LabViewController"
      style="-fx-background-color: #F8FAFC; -fx-padding: 20;">
    <Label text="Laboratory &amp; Diagnostic Test Center" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>

    <HBox spacing="15" VBox.vgrow="ALWAYS">
        <!-- Order Test & Record Result Panel -->
        <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" prefWidth="320">
            <Label text="Order New Diagnostic Test" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <TextField fx:id="visitIdField" promptText="Visit ID (e.g. VISIT-2026-000001)"/>
            <TextField fx:id="testNameField" promptText="Test Name (e.g. Lipid Profile, CBC)"/>
            <Button text="Create Lab Order" onAction="#handleCreateLabOrder" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="290"/>

            <Separator style="-fx-padding: 10 0 10 0;"/>

            <Label text="Update Test Status &amp; Result" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <TextField fx:id="selectedOrderField" promptText="Selected Order ID" editable="false"/>
            <ComboBox fx:id="statusCombo" promptText="Update Status" prefWidth="290"/>
            <TextArea fx:id="resultArea" promptText="Enter lab findings and pathologist observations..." prefHeight="100"/>
            <Button text="💾 Save Lab Result &amp; Update Status" onAction="#handleSaveResult" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="290"/>
            <Button text="🖨️ Print Lab Report" onAction="#handlePrintReport" style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="290"/>
        </VBox>

        <!-- Complete Lab History Table & Report Viewer Split -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Complete Diagnostic Test Orders &amp; Report History" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Show All History" onAction="#loadAllLabOrders" style="-fx-background-color: #475569; -fx-text-fill: white;"/>
                </HBox>
                <TableView fx:id="labOrderTable" VBox.vgrow="ALWAYS" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="orderIdCol" text="Order ID" prefWidth="130"/>
                        <TableColumn fx:id="visitIdCol" text="Visit ID" prefWidth="130"/>
                        <TableColumn fx:id="testNameCol" text="Test Name" prefWidth="160"/>
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="120"/>
                        <TableColumn fx:id="resultCol" text="Findings / Results Summary" prefWidth="220"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Printable HTML Preview Pane -->
            <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" prefHeight="260">
                <Label text="Printable Diagnostic Report Preview" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                <WebView fx:id="reportWebView" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clinical.ui.controller.LabViewController"
      style="-fx-background-color: #F8FAFC; -fx-padding: 20;">
    <Label text="Laboratory &amp; Diagnostics Module" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
    <HBox spacing="15">
        <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" prefWidth="300">
            <Label text="Order New Test" style="-fx-font-weight: bold;"/>
            <TextField fx:id="visitIdField" promptText="Visit ID"/>
            <TextField fx:id="testNameField" promptText="Test Name (e.g. CBC)"/>
            <Button text="Create Lab Order" onAction="#handleCreateLabOrder" style="-fx-background-color: #2563EB; -fx-text-fill: white;"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
            <Label text="Lab Orders Workspace" style="-fx-font-weight: bold;"/>
            <TableView fx:id="labOrderTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="orderIdCol" text="Order ID" prefWidth="120"/>
                    <TableColumn fx:id="visitIdCol" text="Visit ID" prefWidth="120"/>
                    <TableColumn fx:id="testNameCol" text="Test Name" prefWidth="160"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>

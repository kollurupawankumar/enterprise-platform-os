<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clinical.ui.controller.ReportsViewController"
      style="-fx-background-color: #F8FAFC; -fx-padding: 20;">

    <Label text="Reports &amp; Healthcare Analytics Center" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>

    <GridPane hgap="15" vgap="15">
        <!-- 1. Patient EHR Summary -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="1. Patient EHR Medical Summary" style="-fx-font-weight: bold;"/>
            <Label text="Print complete medical history &amp; vitals summary" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
            <ComboBox fx:id="patientCombo" promptText="Select Patient"/>
            <Button text="🖨️ Print EHR Report" onAction="#handlePrintPatientEhr" style="-fx-background-color: #0284C7; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>

        <!-- 2. Invoice & Receipt -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="2. Bill Invoice &amp; Payment Receipt" style="-fx-font-weight: bold;"/>
            <Label text="Print official itemized patient bill invoice" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
            <ComboBox fx:id="invoiceCombo" promptText="Select Invoice No"/>
            <Button text="🖨️ Print Invoice Receipt" onAction="#handlePrintInvoice" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>

        <!-- 3. Lab Test Report -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="3. Laboratory Diagnostic Report" style="-fx-font-weight: bold;"/>
            <Label text="Print official path test diagnostic findings" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
            <ComboBox fx:id="labOrderCombo" promptText="Select Lab Order"/>
            <Button text="🖨️ Print Lab Report" onAction="#handlePrintLabReport" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>

        <!-- 4. Doctor Roster & Performance -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="4. Doctor Roster &amp; Directory Report" style="-fx-font-weight: bold;"/>
            <Label text="Print registered doctors list &amp; fee schedules" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
            <Button text="🖨️ Print Doctor Directory" onAction="#handlePrintDoctorRoster" style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>

        <!-- 5. Pharmacy Inventory Stock -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="5. Pharmacy Stock &amp; Expiry Audit" style="-fx-font-weight: bold;"/>
            <Label text="Print low-stock alerts &amp; drug inventory audit" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
            <Button text="🖨️ Print Stock Audit" onAction="#handlePrintPharmacyStock" style="-fx-background-color: #D97706; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>

        <!-- 6. Specialist Referral Summary -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="6. Specialist Referral Letter" style="-fx-font-weight: bold;"/>
            <Label text="Print official referral letter for external transfer" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
            <ComboBox fx:id="referralCombo" promptText="Select Referral Ref"/>
            <Button text="🖨️ Print Referral Letter" onAction="#handlePrintReferral" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </GridPane>
</VBox>

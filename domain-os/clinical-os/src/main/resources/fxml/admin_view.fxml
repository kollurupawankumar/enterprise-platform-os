<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clinical.ui.controller.AdministrationViewController"
      style="-fx-background-color: #F8FAFC; -fx-padding: 20;">

    <Label text="Hospital Administration &amp; Security Settings" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>

    <HBox spacing="15">
        <!-- User Management Card & Users Table -->
        <VBox spacing="15" prefWidth="420">
            <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Create System User Account" style="-fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" promptText="Username"/>
                <PasswordField fx:id="passwordField" promptText="Password"/>
                <TextField fx:id="fullNameField" promptText="Full Name"/>
                <ComboBox fx:id="roleCombo" promptText="Assign Role" prefWidth="400"/>
                <Button text="Create User Account" onAction="#handleCreateUser" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                <Label text="Existing System Users &amp; Roles" style="-fx-font-weight: bold;"/>
                <TableView fx:id="userTable" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="usernameCol" text="Username" prefWidth="100"/>
                        <TableColumn fx:id="fullNameCol" text="Full Name" prefWidth="130"/>
                        <TableColumn fx:id="roleCol" text="Role" prefWidth="100"/>
                        <TableColumn fx:id="passwordCol" text="Password" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>

        <!-- Clinic Profile & Database Snapshot -->
        <VBox spacing="15" HBox.hgrow="ALWAYS">
            <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Clinic Information Setup &amp; Branding" style="-fx-font-weight: bold;"/>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <ImageView fx:id="logoPreviewImageView" fitWidth="60" fitHeight="60" preserveRatio="true"/>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <TextField fx:id="clinicNameField" text="Apex Multispecialty Clinic" promptText="Clinic Name"/>
                        <HBox spacing="10">
                            <TextField fx:id="logoPathField" promptText="Logo Image File Path" HBox.hgrow="ALWAYS"/>
                            <Button text="Browse Logo" onAction="#handleBrowseLogo" style="-fx-background-color: #0284C7; -fx-text-fill: white;"/>
                        </HBox>
                    </VBox>
                </HBox>
                <TextField fx:id="registrationNoField" text="REG-2026-CLINIC-88" promptText="Registration No."/>
                <HBox spacing="10">
                    <TextField fx:id="idPrefixField" text="PAT" promptText="ID Prefix (e.g. PAT)"/>
                    <TextField fx:id="idFormatField" text="PAT-{YYYY}-{SEQ}" promptText="Format Pattern (e.g. PAT-{YYYY}-{SEQ})" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Button text="Save Clinic Settings &amp; Logo" onAction="#handleSaveClinicSettings" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Database Backup &amp; Recovery" style="-fx-font-weight: bold;"/>
                <Label text="Create full snapshot of clinical records database" style="-fx-text-fill: #64748B;"/>
                <HBox spacing="10">
                    <Button text="💾 Create Database Snapshot" onAction="#handleBackup" style="-fx-background-color: #475569; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label fx:id="backupStatusLabel" style="-fx-text-fill: #059669; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clinical.ui.controller.PharmacyViewController"
      style="-fx-background-color: #F8FAFC; -fx-padding: 20;">
    <Label text="Pharmacy Inventory &amp; Dispensing" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
    <HBox spacing="15">
        <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" prefWidth="300">
            <Label text="Add Stock" style="-fx-font-weight: bold;"/>
            <TextField fx:id="medicineNameField" promptText="Medicine Name"/>
            <TextField fx:id="batchNumberField" promptText="Batch Number"/>
            <TextField fx:id="quantityField" promptText="Quantity"/>
            <TextField fx:id="priceField" promptText="Selling Price"/>
            <Button text="Add Stock Item" onAction="#handleAddStock" style="-fx-background-color: #2563EB; -fx-text-fill: white;"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
            <Label text="Pharmacy Stock Directory" style="-fx-font-weight: bold;"/>
            <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameCol" text="Medicine" prefWidth="160"/>
                    <TableColumn fx:id="batchCol" text="Batch" prefWidth="100"/>
                    <TableColumn fx:id="qtyCol" text="Quantity" prefWidth="90"/>
                    <TableColumn fx:id="priceCol" text="Price (₹)" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clinical.ui.controller.DashboardViewController"
      style="-fx-background-color: #F8FAFC; -fx-padding: 24;">

    <!-- Dashboard Header -->
    <VBox spacing="4">
        <Label text="Clinical &amp; Operational Analytics" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
        <Label text="Real-time clinical queue oversight, patient census, and pharmacy inventory status" style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
    </VBox>

    <!-- Top KPI Cards Row -->
    <HBox spacing="16">
        <VBox spacing="6" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 6, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <Label text="TOTAL REGISTERED PATIENTS" style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label fx:id="totalPatientsLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0284C7;"/>
            <Label text="Active master patient index" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
        </VBox>

        <VBox spacing="6" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 6, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <Label text="ACTIVE OPD QUEUE" style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label fx:id="activeVisitsLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #D97706;"/>
            <Label text="Patients currently in clinic" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
        </VBox>

        <VBox spacing="6" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 6, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <Label text="ACTIVE MEDICAL DOCTORS" style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label fx:id="totalDoctorsLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
            <Label text="Registered medical staff" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
        </VBox>

        <VBox spacing="6" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 6, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <Label text="COMPLETED LAB TESTS" style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label fx:id="completedLabsLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
            <Label text="Diagnostic results ready" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
        </VBox>

        <VBox spacing="6" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 6, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <Label text="LOW STOCK ALERTS" style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label fx:id="lowStockLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
            <Label text="Medicines below reorder level" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
        </VBox>
    </HBox>

    <!-- Operational Analytics Section -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- Tabular Live Patient OPD Census Queue -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Live OPD Patient Census &amp; Queue Breakdown" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Updated Live" style="-fx-text-fill: #059669; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            </HBox>
            <TableView fx:id="queueSummaryTable" VBox.vgrow="ALWAYS" prefHeight="260">
                <columns>
                    <TableColumn fx:id="visitIdCol" text="Visit ID" prefWidth="130"/>
                    <TableColumn fx:id="patientIdCol" text="Patient ID" prefWidth="130"/>
                    <TableColumn fx:id="doctorCol" text="Assigned Doctor" prefWidth="160"/>
                    <TableColumn fx:id="visitTypeCol" text="Type" prefWidth="80"/>
                    <TableColumn fx:id="visitDateCol" text="Visit Date" prefWidth="110"/>
                    <TableColumn fx:id="statusCol" text="Queue Status" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Low Stock Inventory & Clinical Alerts Summary Card -->
        <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" prefWidth="380">
            <Label text="Clinical &amp; Inventory Attention Required" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Label text="Critical Pharmacy Stock Items:" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
                <ListView fx:id="criticalStockListView" prefHeight="180" VBox.vgrow="ALWAYS"/>
                <Label text="Consultations Pending Doctor Note:" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
                <Label fx:id="pendingConsultationsLabel" text="0 Consultations awaiting completion" style="-fx-text-fill: #D97706; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>

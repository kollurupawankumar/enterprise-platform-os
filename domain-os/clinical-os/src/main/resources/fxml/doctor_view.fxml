<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clinical.ui.controller.DoctorViewController"
      style="-fx-background-color: #F8FAFC; -fx-padding: 20;">
    <Label text="Doctor Consultation Workspace" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
    <GridPane hgap="15" vgap="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
        <Label text="Visit ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="visitIdField" promptText="VISIT-2026-000001" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Vitals (BP/Temp/SpO2):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <TextField fx:id="bpField" promptText="BP e.g. 120/80" prefWidth="100"/>
            <TextField fx:id="tempField" promptText="Temp e.g. 98.6F" prefWidth="100"/>
            <TextField fx:id="spo2Field" promptText="SpO2 e.g. 99%" prefWidth="100"/>
        </HBox>

        <Label text="Chief Complaints:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextArea fx:id="complaintsField" prefRowCount="2" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Diagnosis &amp; ICD:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <TextField fx:id="diagnosisField" promptText="Diagnosis" prefWidth="200"/>
            <TextField fx:id="icdField" promptText="ICD Code" prefWidth="100"/>
        </HBox>

        <Button text="Save Consultation Encounter" onAction="#handleSaveEncounter" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>
</VBox>

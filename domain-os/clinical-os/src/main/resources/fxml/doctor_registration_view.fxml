<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clinical.ui.controller.DoctorRegistrationViewController"
      style="-fx-background-color: #F8FAFC; -fx-padding: 20;">

    <Label text="Doctor Directory &amp; Registration Setup" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>

    <HBox spacing="15">
        <!-- Registration Form -->
        <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" prefWidth="320">
            <Label text="Register / Edit Doctor" style="-fx-font-weight: bold;"/>
            <TextField fx:id="nameField" promptText="Full Name (e.g. Dr. Ramesh Kumar)"/>
            <TextField fx:id="specializationField" promptText="Specialization (e.g. Cardiology)"/>
            <TextField fx:id="licenseField" promptText="Medical License No."/>
            <TextField fx:id="phoneField" promptText="Phone Number"/>
            <TextField fx:id="emailField" promptText="Email Address"/>
            <TextField fx:id="feeField" promptText="Consultation Fee (₹)"/>
            <Button text="Save Doctor Record" onAction="#handleSaveDoctor" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Doctor Directory Table -->
        <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
            <Label text="Registered Medical Roster" style="-fx-font-weight: bold;"/>
            <TableView fx:id="doctorTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idCol" text="Doctor ID" prefWidth="110"/>
                    <TableColumn fx:id="nameCol" text="Name" prefWidth="160"/>
                    <TableColumn fx:id="specCol" text="Specialization" prefWidth="140"/>
                    <TableColumn fx:id="phoneCol" text="Phone" prefWidth="120"/>
                    <TableColumn fx:id="feeCol" text="Fee (₹)" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clinical.ui.controller.PatientViewController"
      style="-fx-background-color: #F8FAFC; -fx-padding: 20;">
    <Label text="PatientOS - Longitudinal Patient Directory" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
    <HBox spacing="15">
        <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" prefWidth="300">
            <Label text="Register New Patient" style="-fx-font-weight: bold;"/>
            <TextField fx:id="firstNameField" promptText="First Name"/>
            <TextField fx:id="lastNameField" promptText="Last Name"/>
            <TextField fx:id="phoneField" promptText="Phone Number"/>
            <Button text="Register" onAction="#handleRegister" style="-fx-background-color: #2563EB; -fx-text-fill: white;"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
            <Label text="Patient Directory" style="-fx-font-weight: bold;"/>
            <TableView fx:id="patientTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idCol" text="Patient ID" prefWidth="120"/>
                    <TableColumn fx:id="nameCol" text="Name" prefWidth="180"/>
                    <TableColumn fx:id="phoneCol" text="Phone" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>

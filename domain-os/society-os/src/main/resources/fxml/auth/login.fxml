<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.society.user.controller.LoginController"
           style="-fx-background-color: linear-gradient(to bottom right, #F8FAFC, #E2E8F0);">

    <VBox spacing="25"
          alignment="CENTER"
          maxWidth="450"
          maxHeight="500"
          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(15,23,42,0.06), 20, 0, 0, 10);">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <VBox alignment="CENTER" spacing="6">
            <Label text="Society Office OS"
                   style="-fx-text-fill: #1F4E79; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            <Label text="Digital Memory of the Society"
                   style="-fx-text-fill: #475569; -fx-font-size: 14px;"/>
        </VBox>

        <VBox spacing="15" alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">
            <VBox spacing="6">
                <Label text="Username"
                       style="-fx-text-fill: #334155; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="usernameField"
                           promptText="Enter your username"
                           style="-fx-background-color: white; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8; -fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-padding: 10;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password"
                       style="-fx-text-fill: #334155; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               style="-fx-background-color: white; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8; -fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-padding: 10;"/>
            </VBox>

            <Label fx:id="errorLabel"
                   wrapText="true"
                   style="-fx-text-fill: #EF4444; -fx-font-size: 13px;"
                   visible="false"/>
        </VBox>

        <Button text="Sign In"
                onAction="#handleLogin"
                maxWidth="Infinity"
                style="-fx-background-color: #1F4E79; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>

    </VBox>
</StackPane>

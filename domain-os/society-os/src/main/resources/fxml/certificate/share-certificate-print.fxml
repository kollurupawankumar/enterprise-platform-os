<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.society.certificate.controller.PrintPreviewController"
      prefWidth="1020"
      prefHeight="720"
      spacing="0"
      style="-fx-background-color: white;">

    <!-- Rendered HTML Certificate View -->
    <WebView fx:id="certificateWebView" VBox.vgrow="ALWAYS"/>

</VBox>

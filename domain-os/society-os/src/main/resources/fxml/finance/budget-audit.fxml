<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.society.finance.controller.BudgetAuditController"
         styleClass="main-content">

    <!-- Tab 1: Budgets Planning -->
    <Tab text="Yearly Budgets">
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Budgets Planning &amp; Tracking" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F4E79;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Allocate Budget" onAction="#handleNewBudget" styleClass="button-primary"/>
            </HBox>

            <TableView fx:id="budgetTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="budgetYearCol" text="FY Year" prefWidth="120"/>
                    <TableColumn fx:id="budgetCatCol" text="Category" prefWidth="200"/>
                    <TableColumn fx:id="budgetAllocatedCol" text="Allocated Budget" prefWidth="180"/>
                    <TableColumn fx:id="budgetSpentCol" text="Actual Spent" prefWidth="180"/>
                    <TableColumn fx:id="budgetRemainingCol" text="Remaining Balance" prefWidth="180"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <!-- Tab 2: Audit Query Tracker -->
    <Tab text="Auditor Queries &amp; Observations">
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Audit Observations &amp; Resolutions" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F4E79;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Add Observation" onAction="#handleNewObservation" styleClass="button-primary"/>
            </HBox>

            <TableView fx:id="auditTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="auditDateCol" text="Date Logged" prefWidth="120"/>
                    <TableColumn fx:id="auditAuditorCol" text="Auditor Name" prefWidth="150"/>
                    <TableColumn fx:id="auditObservationCol" text="Observation Query Detail" prefWidth="350"/>
                    <TableColumn fx:id="auditResponseCol" text="Resolution Response" prefWidth="250"/>
                    <TableColumn fx:id="auditStatusCol" text="Status" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>
</TabPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.society.share.controller.ShareAllotmentController"
            stylesheets="/css/share.css">

    <top>

        <VBox spacing="10">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="10"
                        left="20"/>
            </padding>

            <Label text="Issue Share Certificate"
                   styleClass="dashboard-title"/>

        </VBox>

    </top>

    <center>

        <GridPane hgap="15"
                  vgap="15"
                  styleClass="form-card">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="Certificate Number"/>
            <TextField fx:id="certificateNumberField"
                       GridPane.columnIndex="1"/>

            <Label text="Select Member *"
                   GridPane.rowIndex="1"/>
            <ComboBox fx:id="memberComboBox"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="1"/>

            <Label text="Number of Shares *"
                   GridPane.rowIndex="2"/>
            <TextField fx:id="totalSharesField"
                       promptText="e.g. 10 (Standard allocation)"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"/>

            <Label text="From Share No (Auto)"
                   GridPane.rowIndex="3"/>
            <TextField fx:id="fromShareNumberField"
                       promptText="Auto-computed"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="3"/>

            <Label text="To Share No (Auto)"
                   GridPane.rowIndex="4"/>
            <TextField fx:id="toShareNumberField"
                       promptText="Auto-computed"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="4"/>

            <Label text="Face Value per Share (₹)"
                   GridPane.rowIndex="5"/>
            <TextField fx:id="faceValueField"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="5"/>

            <Label text="Total Share Amount"
                   GridPane.rowIndex="6"/>
            <TextField fx:id="totalAmountField"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="6"/>

            <Label text="Issue Date *"
                   GridPane.rowIndex="7"/>
            <DatePicker fx:id="issueDatePicker"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="7"/>

        </GridPane>

    </center>

    <bottom>

        <HBox spacing="10"
              alignment="CENTER_RIGHT">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Button text="Cancel"
                    styleClass="button-secondary"
                    onAction="#cancel"/>

            <Button text="Issue Certificate"
                    styleClass="button-primary"
                    onAction="#saveAllotment"/>

        </HBox>

    </bottom>

</BorderPane>

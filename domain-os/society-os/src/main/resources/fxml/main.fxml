<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootBorderPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.society.common.controller.MainController">

    <top>
        <fx:include fx:id="headerInclude" source="/fxml/header/header.fxml"/>
    </top>

    <left>

        <VBox spacing="8"
              prefWidth="220"
              styleClass="navigation">

            <padding>
                <Insets top="15" right="10" bottom="15" left="10"/>
            </padding>

            <Button
                    fx:id="dashboardButton"
                    text="📊 Dashboard"
                    onAction="#openDashboard"/>

            <Button
                    fx:id="membersButton"
                    text="👤 Members Directory"
                    onAction="#openMembers"/>

            <Button
                    fx:id="propertiesButton"
                    text="🏠 Properties &amp; Flats"
                    onAction="#openProperties"/>

            <Button
                    fx:id="governanceButton"
                    text="⚖️ Governance &amp; Meetings"
                    onAction="#openGovernance"/>

            <Button
                    fx:id="operationsButton"
                    text="🛠️ Operations &amp; AMCs"
                    onAction="#openOperations"/>

            <Button
                    fx:id="financeButton"
                    text="💰 Finance &amp; Accounts"
                    onAction="#openFinance"/>

            <Button
                    fx:id="searchButton"
                    text="🔍 Universal Search"
                    onAction="#openSearch"/>

            <Button
                    fx:id="sharesButton"
                    text="📜 Shares Register"
                    onAction="#openShares"/>

            <Button
                    fx:id="certificatesButton"
                    text="🏅 Certificates"
                    onAction="#openCertificates"/>

            <Button
                    fx:id="reportsButton"
                    text="📈 Reports Center"
                    onAction="#openReports"/>

            <Button
                    fx:id="documentsButton"
                    text="📁 Documents Vault"
                    onAction="#openDocuments"/>

            <Button
                    fx:id="knowledgeBaseButton"
                    text="📚 Knowledge Base"
                    onAction="#openKnowledgeBase"/>

            <Button
                    fx:id="budgetAuditButton"
                    text="📊 Budgets &amp; Audits"
                    onAction="#openBudgetAudit"/>

            <Button
                    fx:id="administrationButton"
                    text="⚙️ Administration"
                    onAction="#openAdministration"/>

            <Button
                    fx:id="aiCopilotButton"
                    text="🤖 AI Copilot"
                    onAction="#toggleAiCopilot"
                    style="-fx-background-color: #1F4E79; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

        </VBox>

    </left>

    <center>

        <StackPane fx:id="contentHost"/>

    </center>

    <right>
        <fx:include fx:id="aiCopilotInclude" source="/fxml/ai/ai_copilot.fxml"/>
    </right>

    <bottom>

        <fx:include source="/fxml/footer/footer.fxml"/>

    </bottom>

</BorderPane>
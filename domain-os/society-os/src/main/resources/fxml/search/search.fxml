<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.6"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.society.search.controller.SearchController"
           styleClass="main-content">

    <!-- Left Panel: FTS Search Console -->
    <VBox spacing="15">
        <padding>
            <Insets top="20" right="10" bottom="20" left="20"/>
        </padding>

        <Label text="Universal Search Console" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1F4E79;"/>
        
        <HBox spacing="10">
            <TextField fx:id="searchBar" promptText="Search members, properties, assets, vouchers..." HBox.hgrow="ALWAYS"
                       style="-fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 14px;"/>
        </HBox>

        <TableView fx:id="searchResultsTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8;">
            <columns>
                <TableColumn fx:id="typeCol" text="Type" prefWidth="120"/>
                <TableColumn fx:id="nameCol" text="Entity Info" prefWidth="250"/>
                <TableColumn fx:id="detailCol" text="Reference Details" prefWidth="250"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Right Panel: Reports & Administration Registers Centre -->
    <VBox spacing="20" style="-fx-background-color: #F8FAFC; -fx-padding: 20;">
        <Label text="Statutory Registers &amp; Reports" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

        <VBox spacing="12">
            <Button text="Generate Member Register (Form I)" onAction="#handleFormI" maxWidth="Infinity" styleClass="button-secondary" style="-fx-alignment: CENTER_LEFT;"/>
            <Button text="Generate Share Register (Form J)" onAction="#handleFormJ" maxWidth="Infinity" styleClass="button-secondary" style="-fx-alignment: CENTER_LEFT;"/>
            <Button text="Export Asset Inventory" onAction="#handleAssetReport" maxWidth="Infinity" styleClass="button-secondary" style="-fx-alignment: CENTER_LEFT;"/>
            <Button text="Export Financial Expense Ledger" onAction="#handleExpenseReport" maxWidth="Infinity" styleClass="button-secondary" style="-fx-alignment: CENTER_LEFT;"/>
        </VBox>
    </VBox>

</SplitPane>

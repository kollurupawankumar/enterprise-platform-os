<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.45"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.society.knowledge.controller.KnowledgeController"
           styleClass="main-content">

    <!-- Left Side: Knowledge Articles List -->
    <VBox spacing="15">
        <padding>
            <Insets top="20" right="15" bottom="20" left="20"/>
        </padding>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Knowledge Base" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F4E79;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Add Note" onAction="#handleNewNote" styleClass="button-primary"/>
        </HBox>

        <!-- Category Selector -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Category:"/>
            <ComboBox fx:id="categoryFilterCombo" prefWidth="180" onAction="#handleFilter"/>
        </HBox>

        <TableView fx:id="notesTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8;">
            <columns>
                <TableColumn fx:id="titleCol" text="Title" prefWidth="180"/>
                <TableColumn fx:id="categoryCol" text="Category" prefWidth="110"/>
                <TableColumn fx:id="authorCol" text="Author" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Right Side: Details View -->
    <VBox spacing="15">
        <padding>
            <Insets top="20" right="20" bottom="20" left="15"/>
        </padding>
        <Label text="Article Viewer" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F4E79;"/>
        
        <Label fx:id="noteTitleLabel" text="Select an article" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
        <Label fx:id="noteMetaLabel" text="Author: N/A | Category: N/A" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
        
        <Separator/>
        
        <TextArea fx:id="noteContentArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-font-size: 14px;"/>
    </VBox>

</SplitPane>

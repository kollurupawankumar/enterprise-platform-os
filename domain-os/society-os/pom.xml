<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.core.os</groupId>
        <artifactId>core-os-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>com.society.os</groupId>
    <artifactId>society-os</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Society OS - Domain Operations Application</name>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Core OS Modules -->
        <dependency>
            <groupId>com.core.os</groupId>
            <artifactId>core-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>com.core.os</groupId>
            <artifactId>core-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.core.os</groupId>
            <artifactId>core-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>com.core.os</groupId>
            <artifactId>core-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.core.os</groupId>
            <artifactId>core-notification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.core.os</groupId>
            <artifactId>core-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.core.os</groupId>
            <artifactId>core-ui-shell</artifactId>
        </dependency>
        <dependency>
            <groupId>com.core.os</groupId>
            <artifactId>core-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.core.os</groupId>
            <artifactId>core-reporting</artifactId>
        </dependency>
        <dependency>
            <groupId>com.core.os</groupId>
            <artifactId>core-search</artifactId>
        </dependency>

        <!-- Spring Boot Log4j2 Logging -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- Testing Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>society-os</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.society.Launcher</mainClass>
                    <launcher>society-os</launcher>
                    <jlinkZipName>society-os-desktop</jlinkZipName>
                    <noHeaderFiles>true</noHeaderFiles>
                    <noManPages>true</noManPages>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-jar-to-dist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/../../dist/app</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>society-os.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>prepare-jpackage-input</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>society-os.jar</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../../ai</directory>
                                    <targetPath>ai</targetPath>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <version>2.5.0</version>
                <executions>
                    <execution>
                        <id>create-society-exe</id>
                        <phase>package</phase>
                        <goals>
                            <goal>launch4j</goal>
                        </goals>
                        <configuration>
                            <headerType>gui</headerType>
                            <outfile>${project.basedir}/../../dist/app/society-os.exe</outfile>
                            <jar>${project.build.directory}/society-os.jar</jar>
                            <errTitle>Society OS Error</errTitle>
                            <classPath>
                                <mainClass>com.society.Launcher</mainClass>
                                <addDependencies>true</addDependencies>
                            </classPath>
                            <jre>
                                <minVersion>17</minVersion>
                            </jre>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>os-mac-detect</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <skip.jpackage.mac>false</skip.jpackage.mac>
                <skip.jpackage.win>true</skip.jpackage.win>
            </properties>
        </profile>
        <profile>
            <id>os-win-detect</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <skip.jpackage.mac>true</skip.jpackage.mac>
                <skip.jpackage.win>false</skip.jpackage.win>
            </properties>
        </profile>
        <profile>
            <id>mac-installer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <configuration>
                            <skip>${skip.jpackage.mac}</skip>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-mac-dmg</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>dmg</argument>
                                        <argument>--name</argument>
                                        <argument>SocietyOS</argument>
                                        <argument>--app-version</argument>
                                        <argument>1.0.0</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument>
                                        <argument>society-os.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>com.society.Launcher</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/../../dist/icons/society-os.icns</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.basedir}/../../dist/installers</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>build-mac-pkg</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>pkg</argument>
                                        <argument>--name</argument>
                                        <argument>SocietyOS</argument>
                                        <argument>--app-version</argument>
                                        <argument>1.0.0</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument>
                                        <argument>society-os.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>com.society.Launcher</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.basedir}/../../dist/installers</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>win-installer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <configuration>
                            <skip>${skip.jpackage.win}</skip>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-win-msi</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>msi</argument>
                                        <argument>--name</argument>
                                        <argument>SocietyOS</argument>
                                        <argument>--app-version</argument>
                                        <argument>1.0.0</argument>
                                         <argument>--input</argument>
                                        <argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument>
                                        <argument>society-os.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>com.society.Launcher</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.basedir}/../../dist/installers</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>build-win-exe-installer</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>exe</argument>
                                        <argument>--name</argument>
                                        <argument>SocietyOS-Installer</argument>
                                        <argument>--app-version</argument>
                                        <argument>1.0.0</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/jpackage-input</argument>

                                        <argument>--main-jar</argument>
                                        <argument>society-os.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>com.society.Launcher</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.basedir}/../../dist/installers</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

